# ReconOS AI Environment Configuration Example

PROJECT_NAME="ReconOS AI"
VERSION="1.0.0"
ENVIRONMENT="development"

# Security
SECRET_KEY="replace-with-a-random-secret-at-least-32-characters"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local database
DATABASE_URL="sqlite:///./reconos_ai.db"

# Docker Compose PostgreSQL credentials (use a URL-safe password)
POSTGRES_USER=reconos_user
POSTGRES_PASSWORD="replace-with-a-random-url-safe-password"
POSTGRES_DB=reconos_db

# AI Engine Controls
AI_ANOMALY_CONTAMINATION=0.05
TOLERANCE_DEFAULT_DAYS=2
